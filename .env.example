# For local development, add these to .dev.vars. Never use a VITE_ prefix for secrets.
TOKEN_ENCRYPTION_KEY=
APP_ORIGIN=http://localhost:3001
OPENAI_API_KEY=
OPENAI_MODEL=
# A registered client ID or publicly accessible HTTPS metadata URL is required locally.
BINANCE_CLIENT_ID=
BINANCE_CLIENT_METADATA_URL=
# Optional exact tool names after authenticated discovery.
BINANCE_BALANCE_TOOL=
BINANCE_ORDER_TOOL=
# Live orders stay disabled until account integration has been verified.
ENABLE_LIVE_TRADING=false
MAX_ORDER_USDT=25
